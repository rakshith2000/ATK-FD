# =============================================================================
# ATK Docker Compose — Environment Variables
# Fill in all <Placeholder> values before running docker compose up
# =============================================================================

# ── DNS / Hostname ────────────────────────────────────────────────────────────
DNS_NAME=<DNS Name>                        # e.g. atk.yourdomain.com (no https://)

# ── PostgreSQL (Main DB) ──────────────────────────────────────────────────────
POSTGRES_USER=<Postgres Superuser Username>
POSTGRES_PASSWORD=<Postgres Superuser Password>
POSTGRES_DB=<ATK Main Database Name>

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=<Keycloak Admin Username>
KEYCLOAK_ADMIN_PASSWORD=<Keycloak Admin Password>
KEYCLOAK_REALM=<Keycloak Realm Name>
KEYCLOAK_DB=<Keycloak Database Name>
KEYCLOAK_DB_USER=<Keycloak DB Username>
KEYCLOAK_DB_PASS=<Keycloak DB Password>

# ── LiteLLM ───────────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=<LiteLLM Master Key>
LITELLM_UI_USERNAME=<LiteLLM UI Username>
LITELLM_UI_PASSWORD=<LiteLLM UI Password>
LITELLM_DB=<LiteLLM Database Name>
LITELLM_DB_USER=<LiteLLM DB Username>
LITELLM_DB_PASS=<LiteLLM DB Password>

# ── ServiceNow / ITSM ─────────────────────────────────────────────────────────
SNOW_URL=<ServiceNow Instance URL>         # e.g. https://yourinstance.service-now.com
KB_BASES=<Knowledge Base Names>            # comma-separated KB base names
KB_FIELDS=<Knowledge Base Fields>          # comma-separated fields to index
