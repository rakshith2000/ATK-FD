# =============================================================================
# ATK FRONTEND machine (10.106.6.228) — Environment Variables
# Hosts: Frontend (React), Admin Console (/v2), nginx
#
# Fill in all <Placeholder> values before running docker compose up
# =============================================================================

# ── DNS / Hostnames ───────────────────────────────────────────────────────────
# This machine serves exactly one DNS record (no https://). Substituted into
# docker-compose.yml to build REACT_APP_ITOPS_MFE_URL.
FRONTEND_DNS_NAME=atkdev.fd.com

# The core machine's hostnames (backend-atkdev.fd.com, sso-atkdev.fd.com) are
# NOT read from here. They are browser-facing URLs and live in:
#   config/config.json    -> frontend      (runtime, restart container)
#   config/app-config.ts  -> admin console (compile-time, rebuild required)
#
# nginx cannot read .env either, so server_name in config/nginx.conf is literal.
# If you rename atkdev.fd.com, update config/nginx.conf too.
