# =============================================================================
# ATK CORE machine (10.106.6.15) — Environment Variables
# Hosts: Vault, Keycloak, Backend, Grafana, LiteLLM, Postgres, nginx
#
# Fill in all <Placeholder> values before running docker compose up
# =============================================================================

# ── DNS / Hostnames ───────────────────────────────────────────────────────────
# One DNS record per service (no https://). Both resolve to 10.106.6.15 and are
# substituted into docker-compose.yml.
SSO_DNS_NAME=sso-atkdev.fd.com              # Keycloak    -> KC_HOSTNAME
BACKEND_DNS_NAME=backend-atkdev.fd.com      # Backend API -> also hosts /grafana and /litellm

# The two remaining hostnames are NOT read from here — change them in the file
# listed next to each, or they will have no effect:
#   vault-atkdev.fd.com  -> config/nginx.conf  (server_name of the Vault block)
#   atkdev.fd.com        -> config/.keycloak_env (KEYCLOAK_REDIRECTION_URL)
#
# nginx cannot read .env, so every server_name in config/nginx.conf is literal.
# If you rename any hostname, update config/nginx.conf too.

# ── PostgreSQL (Main DB) ──────────────────────────────────────────────────────
POSTGRES_USER=<Postgres Superuser Username>
POSTGRES_PASSWORD=<Postgres Superuser Password>
POSTGRES_DB=<ATK Main Database Name>

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=<Keycloak Admin Username>
KEYCLOAK_ADMIN_PASSWORD=<Keycloak Admin Password>
KEYCLOAK_REALM=<Keycloak Realm Name>
KEYCLOAK_DB=<Keycloak Database Name>
KEYCLOAK_DB_USER=<Keycloak DB Username>
KEYCLOAK_DB_PASS=<Keycloak DB Password>

# ── LiteLLM ───────────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=<LiteLLM Master Key>
LITELLM_UI_USERNAME=<LiteLLM UI Username>
LITELLM_UI_PASSWORD=<LiteLLM UI Password>
LITELLM_DB=<LiteLLM Database Name>
LITELLM_DB_USER=<LiteLLM DB Username>
LITELLM_DB_PASS=<LiteLLM DB Password>

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<Grafana Admin Password>

# ── ServiceNow / ITSM ─────────────────────────────────────────────────────────
SNOW_URL=<ServiceNow Instance URL>         # e.g. https://yourinstance.service-now.com
KB_BASES=<Knowledge Base Names>            # comma-separated KB base names
KB_FIELDS=<Knowledge Base Fields>          # comma-separated fields to index
