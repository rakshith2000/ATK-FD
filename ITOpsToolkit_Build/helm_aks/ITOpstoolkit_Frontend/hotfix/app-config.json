    "serviceNow": {
        "api": {
            "baseUrl": "<Servicenow URL>",
            "userDetails": "/api/now/table/sys_user",
            "userMemberOfAssignmentGroupsByUserSysId": "/api/now/table/sys_user_grmember?sysparm_fields=group&sysparm_display_value=all&sysparm_query=user=<USER_SYS_ID_PLACEHOLDER>",
