            "incidentTable": "/api/now/table/incident",
            "knowledgeTable": "/api/now/table/kb_knowledge",
            "problemTable": "/api/now/table/problem",
            "scRequestTable": "/api/now/table/sc_request",
            "sysChoiceTable": "/api/now/table/sys_choice",
            "ticketsAssignedByUserSysId": "/api/now/table/<TICKET_TYPE_PLACEHOLDER>?sysparm_query=assigned_to%3D<USER_SYS_ID_PLACEHOLDER>%5EstateNOT%20IN6%2C7&sysparm_display_value=all",
            "ticketsAssignedByGroupQuery": "/api/now/table/<TICKET_TYPE_PLACEHOLDER>?sysparm_query=assignment_group%3D<GROUP_QUERY>NQstate!%3D6%5E7%5E8&sysparm_display_value=all&sysparm_limit=20",
            "ticketsUnassignedByTicketType": "/api/now/table/<TICKET_TYPE_PLACEHOLDER>?sysparm_query=assigned_toISEMPTY%5EstateNOT%20IN6%2C7%2C3&sysparm_limit=15&sysparm_display_value=all",
            "ticketStateChoiceByTicketType": "/api/now/table/sys_choice?sysparm_query=name=<TICKET_TYPE_PLACEHOLDER>^element=state&sysparm_fields=label,value,sys_id",
            "ticketRequestStateChoiceByTicketType": "/api/now/table/sys_choice?sysparm_query=name=<TICKET_TYPE_PLACEHOLDER>^element=request_state&sysparm_fields=label,value,sys_id",
            "ticketJournalEntriesTypeTicketSysId": "/api/now/table/sys_journal_field?sysparm_query=element_id=<TICKET_SYS_ID_PLACEHOLDER>^elementINwork_notes,comments,close_notes,resolution_notes^ORDERBYDESCsys_created_on&sysparm_fields=element,value,sys_created_by,sys_created_on",
            "ticketAuditEntriesTypeTicketSysId": "/api/now/table/sys_audit?sysparm_query=documentkey=<TICKET_SYS_ID_PLACEHOLDER>^fieldnameNOT INwork_notes,comments,close_notes,resolution_notes^ORDERBYDESCsys_created_on&sysparm_fields=fieldname,oldvalue,newvalue,sys_created_by,sys_created_on",
            "ticketRelatedIncidentsByTicketCmdbCiId": "/api/now/table/incident?sysparm_query=sys_id!=<CURRENT_TICKET_SYSID>^cmdb_ci=<CMDB_CI_ID_PLACEHOLDER>^ORDERBYDESCsys_created_on&sysparm_limit=5&sysparm_display_value=all&sysparm_fields=number,short_description,state,severity,opened_at,sys_id,priority",
            "ticketRelatedChangesByTicketCmdbCiId": "/api/now/table/change_request?sysparm_query=cmdb_ci=<CMDB_CI_ID_PLACEHOLDER>^ORDERBYDESCsys_created_on&sysparm_limit=5&sysparm_display_value=all&sysparm_fields=number,short_description,state,severity,opened_at,sys_id,priority",
            "ticketRelatedAlertsByTicketSysId": "/api/now/table/em_alert?sysparm_query=incident=<SYS_ID_PLACEHOLDER>&sysparm_fields=number,short_description,state,severity,priority,opened_at,source,sys_id&sysparm_display_value=all&sysparm_limit=5",
            "groupMembersByGroupSysId": "/api/now/table/sys_user_grmember?sysparm_display_value=all&sysparm_fields=user,sys_id&sysparm_query=group=<GROUP_SYS_ID_PLACEHOLDER>",
            "searchCmdbCi": "/api/now/table/cmdb_ci?sysparm_fields=name,sys_id&sysparm_limit=20&sysparm_query=nameLIKE<SEARCH_TERM_PLACEHOLDER>",
            "patchTicketBySysId": "api/now/table/<TICKET_TYPE_PLACEHOLDER>/<SYS_ID_PLACEHOLDER>?sysparm_display_value=all",
            "ticketRelatedProblemsByTicketCmdbCiId": "/api/now/table/problem?sysparm_query=sys_id!=<CURRENT_TICKET_SYSID>^cmdb_ci=<CMDB_CI_ID_PLACEHOLDER>^ORDERBYDESCsys_created_on&sysparm_limit=5&sysparm_display_value=all&sysparm_fields=number,short_description,state,severity,opened_at,sys_id,priority",
            "ticketRelatedProblemAlertsByTicketSysId": "/api/now/table/em_alert?sysparm_query=problem=<SYS_ID_PLACEHOLDER>&sysparm_fields=number,short_description,state,severity,priority,opened_at,source,sys_id&sysparm_display_value=all&sysparm_limit=5",
            "userRelatedRequestsByUserSysId": "/api/now/table/sc_request?sysparm_query=sys_id!=<CURRENT_TICKET_SYSID>^requested_for=<USER_SYS_ID_PLACEHOLDER>^ORDERBYDESCsys_created_on&sysparm_limit=5&sysparm_display_value=all",
            "relatedRequestsByShortDescription": "/api/now/table/sc_request?sysparm_query=sys_id!=<CURRENT_TICKET_SYSID>^short_descriptionLIKE<KEYWORD_PLACEHOLDER>^ORDERBYDESCsys_created_on&sysparm_limit=5&sysparm_display_value=all",
            "knowledgeUserCriteria": "/api/now/table/user_criteria",
            "knowledgeBaseReadAccess": "/api/now/table/kb_uc_can_read_mtom",
            "knowledgeArticles": "/api/now/table/kb_knowledge",
            "ticketAttachments": "/api/now/table/sys_attachment",
            "ticketDownloadAttachment": "/api/now/attachment/<ATTACHMENT_SYS_ID_PLACEHOLDER>/file",
            "ticketUploadAttachment": "/api/now/attachment/file",
            "ticketRelatedIncidentByTicketSysId": "/api/now/table/incident?sysparm_query=problem_id=<SYS_ID_PLACEHOLDER>^ORDERBYDESCsys_created_on&sysparm_display_value=all&sysparm_fields=number,short_description,state,severity,opened_at,sys_id,priority",
            "submitChangeRequest": "/api/now/table/change_request",
            "taskSlaTable": "/api/now/table/task_sla"
