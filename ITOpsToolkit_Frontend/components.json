{
    "$schema": "https://ui.shadcn.com/schema.json",
    "style": "base-nova",
    "rsc": false,
    "tsx": true,
    "tailwind": {
        "config": "tailwind.config.js",
        "css": "src/index.css",
        "baseColor": "neutral",
        "cssVariables": true,
        "prefix": ""
    },
    "iconLibrary": "lucide",
    "rtl": false,
    "menuColor": "default",
    "menuAccent": "subtle",
    "aliases": {
        "components": "@/shadcn/components",
        "utils": "@/shadcn/lib/utils",
        "ui": "@/shadcn/components/ui",
        "reui": "@/shadcn/components/reui",
        "lib": "@/shadcn/lib",
        "hooks": "@/shadcn/hooks"
    },
    "registries": {
        "@reui": "https://reui.io/r/{style}/{name}.json"
    }
}
